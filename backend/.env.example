# Copiar a .env y ajustar. Todas las variables llevan el prefijo PROSTA_.
PROSTA_DATABASE_URL=postgresql+psycopg://prosta@localhost:5433/prosta_ai
PROSTA_STORAGE_DIR=../almacenamiento
PROSTA_SECRET_KEY=cambiar-esta-clave-en-produccion
PROSTA_TOKEN_HORAS=8
PROSTA_MAX_UPLOAD_MB=500
PROSTA_MODELO_NOMBRE=prostate_mri_anatomy
PROSTA_MODELO_DIR=../modelos
PROSTA_WORKER_INTERVALO_S=2
PROSTA_WORKER_ACTIVO=true
PROSTA_CORS_ORIGINS=http://localhost:5173
